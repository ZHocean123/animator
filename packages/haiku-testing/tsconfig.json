{
  "compileOnSave": true,
  "compilerOptions": {
    "allowJs": false,
    "declaration": true,
    "declarationDir": "lib",
    "module": "preserve",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "outDir": "lib",
    "preserveConstEnums": true,
    "rootDir": "src",
    "sourceMap": true,
    "target": "esnext",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "typeRoots": [
      "node_modules/@types/"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
