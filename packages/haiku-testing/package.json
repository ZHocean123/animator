{
  "name": "haiku-testing",
  "version": "5.1.2",
  "type": "module",
  "description": "Testing utilities for Haiku.",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "require": "./lib/index.cjs",
      "import": "./lib/index.mjs"
    },
    "./assertions": {
      "require": "./lib/assertions.cjs",
      "import": "./lib/assertions.mjs"
    },
    "./mock": {
      "require": "./lib/mock.cjs",
      "import": "./lib/mock.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.cjs",
  "directories": {
    "lib": "lib"
  },
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.cts",
  "scripts": {
    "lint": "eslint src/**/*.{ts,tsx,js,jsx} --fix",
    "lint-report": "pnpm lint -f checkstyle -o checkstyle-result.xml",
    "fix": "pnpm lint --fix",
    "ts": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "pnpm ts ./node_modules/.bin/tape 'test/**/*.test.ts' | tap-spec",
    "test-report": "nyc pnpm ts ./node_modules/.bin/tape 'test/**/*.test.ts' > test-result.tap",
    "compile": "tsdown",
    "develop": "tsdown --watch",
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "authors": [
    "Sasha Joseph <sasha@haiku.ai>"
  ],
  "dependencies": {
    "@types/node": "^22.0.0",
    "@types/tape": "^4.2.32",
    "sinon": "^5.0.10",
    "xml-js": "^1.6.4"
  },
  "devDependencies": {
    "cross-env": "^5.1.6",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "leaked-handles": "^5.2.0",
    "nyc": "^13.0.1",
    "tap-spec": "^4.1.2",
    "tape": "^4.9.0",
    "ts-node": "^6.1.0",
    "tsconfig-paths": "^3.3.2",
    "typescript": "catalog:"
  }
}
