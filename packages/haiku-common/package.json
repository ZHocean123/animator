{
  "name": "haiku-common",
  "version": "5.1.2",
  "type": "module",
  "description": "Common library for Haiku.",
  "authors": [
    "Sasha Joseph <sasha@haiku.ai>"
  ],
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "require": "./lib/index.cjs",
      "import": "./lib/index.mjs"
    },
    "./electron/TopMenu": {
      "require": "./lib/electron/TopMenu.cjs",
      "import": "./lib/electron/TopMenu.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.cts",
  "scripts": {
    "lint": "eslint src/**/*.{ts,tsx,js,jsx} --fix",
    "lint-report": "pnpm lint -f checkstyle -o checkstyle-result.xml",
    "fix": "pnpm lint --fix",
    "ts": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "pnpm ts ./node_modules/.bin/tape 'test/**/*.test.ts' | tap-spec",
    "test-report": "nyc pnpm ts ./node_modules/.bin/tape 'test/**/*.test.ts' > test-result.tap",
    "compile": "tsdown",
    "develop": "tsdown --watch",
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "peerDependencies": {
    "electron": "catalog:"
  },
  "dependencies": {
    "@haiku/core": "workspace:*",
    "@types/node": "^22.19.1",
    "haiku-sdk-creator": "workspace:*",
    "haiku-vendor-legacy": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "cross-env": "^7.0.3",
    "haiku-testing": "workspace:*",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "leaked-handles": "^5.2.0",
    "nyc": "^15.1.0",
    "tap-spec": "^5.0.0",
    "tape": "^5.7.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "catalog:"
  }
}
