{
  "compileOnSave": true,
  "compilerOptions": {
    "target": "esnext",
    "rootDir": "src",
    "module": "preserve",
    "moduleResolution": "bundler",
    "typeRoots": [
      "node_modules/@types/"
    ],
    "types": [
      "node"
    ],
    "allowJs": false,
    "noImplicitAny": true,
    "declaration": true,
    "declarationDir": "lib",
    "outDir": "lib",
    "preserveConstEnums": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/config/*.json"
  ]
}
