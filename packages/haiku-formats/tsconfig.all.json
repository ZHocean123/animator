{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@formats/*": [
        "src/*"
      ],
      "@core/*": [
        "../@haiku/core/src/*"
      ]
    },
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/*.ts"
  ],
  "exclude": [
    "src/**"
  ]
}
