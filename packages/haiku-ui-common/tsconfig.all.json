{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@ui-common/*": [
        "src/*"
      ]
    },
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "scripts/*.ts"
  ],
  "exclude": [
    "src/**"
  ]
}
