{
  "name": "haiku-ui-common",
  "version": "5.1.2",
  "description": "Common UI components for Haiku projects.",
  "type": "module",
  "main": "lib/index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "lint": "tslint -p tsconfig.all.json -t stylish",
    "lint-report": "pnpm lint -t checkstyle -o checkstyle-result.xml",
    "fix": "pnpm lint --fix",
    "ts": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json ./node_modules/tape/bin/tape 'test/**/*.test.ts' | tap-spec",
    "test-report": "nyc pnpm ts ./node_modules/tape/bin/tape 'test/**/*.test.ts' > test-result.tap",
    "compile": "tsdown",
    "develop": "tsdown --watch"
  },
  "authors": [
    "Sasha Joseph <sasha@haiku.ai>"
  ],
  "devDependencies": {
    "@haiku/sdk-inkstone": "workspace:*",
    "@types/color": "^3.0.0",
    "@types/decamelize": "^1.2.0",
    "@types/dedent": "^0.7.0",
    "@types/memoize-one": "^4.1.0",
    "@types/numeral": "^0.0.22",
    "@types/react": "^18.3.0",
    "@types/react-color": "^2.14.0",
    "cross-env": "^7.0.3",
    "electron": "^22.3.0",
    "haiku-testing": "workspace:*",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "leaked-handles": "^5.2.0",
    "nyc": "^13.0.1",
    "tap-spec": "^4.1.2",
    "tape": "^4.9.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslint": "^5.11.0",
    "tslint-config-haiku": "^1.0.16",
    "tsdown": "^0.16.5",
    "typescript": "^5.6.0"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "better-react-spinkit": "2.0.0-4",
    "color": "^2.0.1",
    "decamelize": "^1.2.0",
    "dedent": "^0.7.0",
    "haiku-common": "workspace:*",
    "haiku-sdk-creator": "workspace:*",
    "haiku-serialization": "workspace:*",
    "memoize-one": "5.0.0",
    "numeral": "^2.0.6",
    "radium": "0.18.1",
    "react": "^18.3.0",
    "react-color": "^2.14.1",
    "react-copy-to-clipboard": "^5.0.0",
    "react-dom": "^18.3.0",
    "react-popover": "^0.4.18",
    "react-syntax-highlighter": "^7.0.0"
  }
}
