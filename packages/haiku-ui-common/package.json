{
  "name": "haiku-ui-common",
  "type": "module",
  "version": "5.1.2",
  "description": "Common UI components for Haiku projects.",
  "authors": [
    "Sasha Joseph <sasha@haiku.ai>"
  ],
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.cts",
  "scripts": {
    "lint": "eslint src/**/*.{ts,tsx,js,jsx} --fix",
    "lint-report": "pnpm lint -f checkstyle -o checkstyle-result.xml",
    "fix": "pnpm lint --fix",
    "ts": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "pnpm ts ./node_modules/.bin/tape 'test/**/*.test.ts' | tap-spec",
    "test-report": "nyc pnpm ts ./node_modules/.bin/tape 'test/**/*.test.ts' > test-result.tap",
    "compile": "tsdown",
    "develop": "tsdown --watch",
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "better-react-spinkit": "2.0.0-4",
    "color": "^4.2.3",
    "decamelize": "^6.0.0",
    "dedent": "^1.0.0",
    "haiku-common": "workspace:*",
    "haiku-sdk-creator": "workspace:*",
    "haiku-serialization": "workspace:*",
    "memoize-one": "^6.0.0",
    "numeral": "^2.0.6",
    "radium": "^0.26.2",
    "react": "catalog:",
    "react-color": "^2.19.3",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "catalog:",
    "react-popover": "^0.5.10",
    "react-syntax-highlighter": "^16.1.0"
  },
  "devDependencies": {
    "@haiku/sdk-inkstone": "workspace:*",
    "@types/color": "^3.0.6",
    "@types/decamelize": "^3.0.6",
    "@types/dedent": "^0.7.2",
    "@types/memoize-one": "^5.1.2",
    "@types/node": "^22.19.1",
    "@types/numeral": "^2.0.5",
    "@types/react": "catalog:",
    "@types/react-color": "^3.0.12",
    "@types/react-syntax-highlighter": "^15.5.11",
    "cross-env": "^7.0.3",
    "electron": "catalog:",
    "haiku-testing": "workspace:*",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "leaked-handles": "^5.2.0",
    "nyc": "^15.1.0",
    "tap-spec": "^5.0.0",
    "tape": "^5.7.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "catalog:"
  }
}
