{
  "name": "haiku-ui-common",
  "version": "5.1.2",
  "description": "Common UI components for Haiku projects.",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs",
      "types": "./lib/index.d.ts"
    },
    "./*": {
      "import": "./lib/*.mjs",
      "require": "./lib/*.cjs",
      "types": "./lib/*.d.ts"
    }
  },
  "scripts": {
    "lint": "eslint --ext .ts",
    "lint-report": "pnpm lint -f checkstyle -o checkstyle-result.xml",
    "fix": "pnpm lint --fix",
    "ts": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "pnpm ts ./node_modules/.bin/tape 'test/**/*.test.ts' | tap-spec",
    "test-report": "nyc yarn ts ./node_modules/.bin/tape 'test/**/*.test.ts' > test-result.tap",
    "compile": "tsdown",
    "develop": "tsdown --watch",
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "authors": [
    "Sasha Joseph <sasha@haiku.ai>"
  ],
  "devDependencies": {
    "@haiku/sdk-inkstone": "workspace:*",
    "@types/color": "^3.0.0",
    "@types/react-color": "^2.14.0",
    "@types/decamelize": "^1.2.0",
    "@types/dedent": "^0.7.0",
    "@types/numeral": "^0.0.22",
    "@types/react": "15.6.11",
    "@types/memoize-one": "^4.1.0",
    "electron": "2.0.8",
    "cross-env": "^5.1.6",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "nyc": "^13.0.1",
    "tap-spec": "^4.1.2",
    "tape": "^4.9.0",
    "ts-node": "^6.1.0",
    "tsconfig-paths": "^3.3.2",
    "typescript": "^3.0.3",
    "leaked-handles": "^5.2.0",
    "haiku-testing": "workspace:*"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "better-react-spinkit": "2.0.0-4",
    "color": "^2.0.1",
    "decamelize": "^1.2.0",
    "dedent": "^0.7.0",
    "haiku-common": "workspace:*",
    "haiku-serialization": "workspace:*",
    "haiku-sdk-creator": "workspace:*",
    "memoize-one": "5.0.0",
    "numeral": "^2.0.6",
    "radium": "0.18.1",
    "react": "15.6.2",
    "react-color": "^2.14.1",
    "react-copy-to-clipboard": "^5.0.0",
    "react-dom": "15.6.2",
    "react-popover": "^0.4.18",
    "react-syntax-highlighter": "^7.0.0"
  }
}