{
  "compileOnSave": true,
  "compilerOptions": {
    "allowJs": false,
    "declaration": true,
    "declarationDir": "lib",
    "jsx": "react",
    "lib": [
      "dom",
      "es2017"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "lib",
    "preserveConstEnums": true,
    "rootDir": "src",
    "target": "esnext",
    "typeRoots": [
      "node_modules/@types/"
    ],
    "skipLibCheck": true,
    "strict": false,
    "noImplicitReturns": false,
    "noImplicitThis": false,
    "noEmitOnError": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "noFallthroughCasesInSwitch": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}