{
  "name": "haiku-plumbing",
  "version": "5.1.2",
  "description": "Haiku plumbing (serializer, processes, etc)",
  "authors": [
    "Zack Brown <zack@haiku.ai>",
    "Matthew Trost <matthew@haiku.ai>",
    "Taylor Poe <taylor@haiku.ai>"
  ],
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.cts",
  "scripts": {
    "lint": "eslint src/**/*.{ts,tsx,js,jsx} --fix",
    "lint-report": "pnpm lint -t checkstyle -o checkstyle-result.xml",
    "fix": "pnpm lint --fix",
    "ts": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "pnpm ts ./node_modules/.bin/tape 'test/**/*.test.ts' 'test/**/*.test.js' | tap-spec",
    "e2e": "pnpm ts ./node_modules/.bin/tape 'test/e2e/*.e2e.ts' | tap-spec",
    "test-report": "nyc pnpm ts ./node_modules/.bin/tape 'test/**/*.test.ts' 'test/**/*.test.js' > test-result.tap",
    "compile": "tsdown",
    "compile-declarations": "tsdown -p tsconfig.declarations.json",
    "develop": "tsdown --watch",
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@haiku/cli": "workspace:*",
    "@haiku/core": "workspace:*",
    "@haiku/sdk-client": "workspace:*",
    "@haiku/sdk-inkstone": "workspace:*",
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-json": "^6.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@sentry/node": "^7.108.0",
    "async": "^3.2.4",
    "chokidar": "^3.5.3",
    "dedent": "^1.0.0",
    "fs-extra": "^11.1.1",
    "haiku-common": "workspace:*",
    "haiku-formats": "workspace:*",
    "haiku-fs-extra": "workspace:*",
    "haiku-sdk-creator": "workspace:*",
    "haiku-serialization": "workspace:*",
    "lodash": "^4.17.21",
    "lodash.assign": "^4.2.0",
    "lodash.clone": "^4.5.0",
    "lodash.debounce": "4.0.8",
    "lodash.filter": "^4.6.0",
    "lodash.find": "^4.6.0",
    "lodash.foreach": "^4.5.0",
    "lodash.merge": "4.6.0",
    "lodash.throttle": "4.1.1",
    "moment": "^2.30.1",
    "qs": "^6.12.0",
    "rollup": "^4.21.2",
    "semver": "^7.6.0",
    "simple-git": "^3.23.0",
    "tmp": "^0.2.3",
    "ws": "^8.17.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.5",
    "@types/node": "^22.19.1",
    "@types/semver": "^7.5.8",
    "@types/ws": "^8.5.10",
    "cross-env": "^7.0.3",
    "electron": "catalog:",
    "haiku-creator": "workspace:*",
    "haiku-testing": "workspace:*",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "leaked-handles": "^5.2.0",
    "nyc": "^15.1.0",
    "tap-spec": "^5.0.0",
    "tape": "^5.7.2",
    "tmp": "^0.2.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "catalog:"
  }
}
