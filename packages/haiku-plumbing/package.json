{
  "name": "haiku-plumbing",
  "version": "5.1.2",
  "description": "Haiku plumbing (serializer, processes, etc)",
  "authors": [
    "Zack Brown <zack@haiku.ai>",
    "Matthew Trost <matthew@haiku.ai>",
    "Taylor Poe <taylor@haiku.ai>"
  ],
  "license": "UNLICENSED",
  "main": "index.js",
  "scripts": {
    "lint": "tslint -p tsconfig.all.json -t stylish",
    "lint-report": "pnpm lint -t checkstyle -o checkstyle-result.xml",
    "fix": "pnpm lint --fix",
    "ts": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json ./node_modules/tape/bin/tape 'test/**/*.test.ts' 'test/**/*.test.js' | tap-spec",
    "e2e": "pnpm ts ./node_modules/.bin/tape 'test/e2e/*.e2e.ts' | tap-spec",
    "test-report": "nyc pnpm ts ./node_modules/tape/bin/tape 'test/**/*.test.ts' 'test/**/*.test.js' > test-result.tap",
    "compile": "tsc",
    "compile-declarations": "tsc -p tsconfig.declarations.json",
    "develop": "tsc --watch"
  },
  "dependencies": {
    "@haiku/cli": "workspace:*",
    "@haiku/core": "workspace:*",
    "@haiku/sdk-client": "workspace:*",
    "@haiku/sdk-inkstone": "workspace:*",
    "@ronomon/base64": "^2.4.1",
    "async": "^2.5.0",
    "chokidar": "^1.7.0",
    "dedent": "^0.7.0",
    "fs-extra": "^11.2.0",
    "haiku-common": "workspace:*",
    "haiku-formats": "workspace:*",
    "haiku-fs-extra": "workspace:*",
    "haiku-sdk-creator": "workspace:*",
    "haiku-serialization": "workspace:*",
    "isomorphic-git": "^1.35.0",
    "lodash": "^4.17.21",
    "lodash.assign": "^4.2.0",
    "lodash.clone": "^4.5.0",
    "lodash.debounce": "4.0.8",
    "lodash.filter": "^4.6.0",
    "lodash.find": "^4.6.0",
    "lodash.foreach": "^4.5.0",
    "lodash.merge": "4.6.0",
    "lodash.throttle": "4.1.1",
    "moment": "^2.29.4",
    "qs": "^6.12.0",
    "raven": "2.3.0",
    "rollup": "^0.53.3",
    "rollup-plugin-commonjs": "^8.2.6",
    "rollup-plugin-includepaths": "^0.2.2",
    "rollup-plugin-json": "^2.3.0",
    "rollup-plugin-node-resolve": "^3.0.0",
    "rollup-plugin-uglify-es": "^0.0.1",
    "semver": "^7.6.0",
    "tmp": "0.0.31",
    "ws": "3.2.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/es6-promise": "^3.3.0",
    "@types/fs-extra": "^11.0.0",
    "@types/semver": "^5.4.1",
    "cross-env": "^7.0.3",
    "electron": "^22.3.0",
    "haiku-creator": "workspace:*",
    "haiku-testing": "workspace:*",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "leaked-handles": "^5.2.0",
    "nyc": "^13.0.1",
    "spectron": "^3.8.0",
    "tap-spec": "^4.1.2",
    "tape": "^4.9.0",
    "tmp": "0.0.31",
    "ts-node": "^10.9.2",
    "tsc": "^2.0.4",
    "tsconfig-paths": "^4.2.0",
    "tslint": "^5.11.0",
    "tslint-config-haiku": "^1.0.16",
    "typescript": "^5.6.0"
  }
}