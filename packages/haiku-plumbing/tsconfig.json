{
  "compileOnSave": true,
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 覆盖基础配置的特定选项
    "allowJs": true,
    "declarationDir": "lib",
    "preserveConstEnums": true,
    "outDir": "lib",
    "rootDir": "src",
    "typeRoots": [
      "node_modules/@types/"
    ],
    "skipLibCheck": true,
    // 包特定的路径映射
    "baseUrl": ".",
    "paths": {
    }
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "lib",
    "dist"
  ]
}
