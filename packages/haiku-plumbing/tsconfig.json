{
  "compileOnSave": true,
  "compilerOptions": {
    "allowJs": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "outDir": "lib",
    "preserveConstEnums": true,
    "rootDir": "src",
    "sourceMap": true,
    "target": "ES2020",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts"
  ]
}