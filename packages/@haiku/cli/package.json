{
  "name": "@haiku/cli",
  "version": "5.1.2",
  "description": "Haiku CLI",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./haiku-cli": {
      "import": "./lib/haiku-cli.mjs",
      "require": "./lib/haiku-cli.cjs"
    },
    "./nib": {
      "import": "./lib/nib/index.mjs",
      "require": "./lib/nib/index.cjs"
    },
    "./nib/nib": {
      "import": "./lib/nib/nib.mjs",
      "require": "./lib/nib/nib.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.cts",
  "bin": {
    "haiku": "./bin/haiku"
  },
  "authors": [
    "Zack Brown <zack@haiku.ai>",
    "Matthew Trost <matthew@haiku.ai>"
  ],
  "files": [
    "bin/**/*",
    "lib/**/*",
    "src/**/*"
  ],
  "scripts": {
    "lint": "eslint src/**/*.{ts,tsx,js,jsx} --fix",
    "lint-report": "pnpm lint -f checkstyle -o checkstyle-result.xml",
    "fix": "pnpm lint --fix",
    "ts": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "pnpm ts ./node_modules/.bin/tape 'test/**/*.test.ts' | tap-spec",
    "test-report": "nyc pnpm ts ./node_modules/.bin/tape 'test/**/*.test.ts' > test-result.tap",
    "compile": "tsdown",
    "develop": "tsdown --watch"
  },
  "dependencies": {
    "@haiku/sdk-client": "workspace:*",
    "@haiku/sdk-inkstone": "workspace:*",
    "async": "^2.5.0",
    "chalk": "^2.4.2",
    "cli-color": "^1.2.0",
    "dedent": "^0.7.0",
    "fs-extra": "^4.0.2",
    "hasbin": "^1.2.3",
    "inquirer": "^3.0.6",
    "lodash": "^4.17.4",
    "mkdirp": "^0.5.1",
    "prepend-file": "^1.3.1",
    "request": "^2.83.0",
    "semver": "^5.4.1",
    "tail": "^1.2.1",
    "yargs": "^6.6.0"
  },
  "devDependencies": {
    "@types/cli-color": "^0.3.29",
    "@types/inquirer": "0.0.32",
    "@types/mkdirp": "^0.3.29",
    "@types/request": "^2.0.0",
    "@types/yargs": "^6.5.0",
    "cross-env": "^5.1.6",
    "haiku-testing": "workspace:*",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "leaked-handles": "^5.2.0",
    "nyc": "^13.0.1",
    "tap-spec": "^4.1.2",
    "tape": "^4.9.0",
    "ts-node": "^6.1.0",
    "tsconfig-paths": "^3.3.2",
    "typescript": "catalog:"
  }
}
