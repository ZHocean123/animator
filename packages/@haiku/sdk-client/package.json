{
  "name": "@haiku/sdk-client",
  "version": "5.1.2",
  "description": "Haiku SDK for Client",
  "main": "lib/index.js",
  "scripts": {
    "lint": "tslint -p tsconfig.all.json -t stylish",
    "lint-report": "pnpm lint -t checkstyle -o checkstyle-result.xml",
    "fix": "pnpm lint --fix",
    "ts": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json ./node_modules/tape/bin/tape 'test/**/*.test.ts' | tap-spec",
    "test-report": "nyc pnpm ts ./node_modules/tape/bin/tape 'test/**/*.test.ts' > test-result.tap",
    "compile": "tsdown",
    "develop": "tsdown --watch"
  },
  "files": [
    "lib/**/*"
  ],
  "author": "Zack Brown <zack@haiku.ai>",
  "license": "UNLICENSED",
  "types": "./lib/index.d.ts",
  "dependencies": {
    "@haiku/sdk-inkstone": "5.1.2",
    "dedent": "^0.7.0",
    "dotenv": "^16.4.5",
    "fs-extra": "^11.2.0",
    "mkdirp": "^0.5.1",
    "pascalcase": "0.1.1",
    "request": "^2.83.0",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@types/dedent": "^0.7.0",
    "@types/dotenv": "^4.0.3",
    "@types/fs-extra": "^11.0.0",
    "@types/mkdirp": "^0.3.29",
    "@types/node": "^22.0.0",
    "@types/request": "^2.0.0",
    "cross-env": "^7.0.3",
    "haiku-testing": "5.1.2",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "leaked-handles": "^5.2.0",
    "nyc": "^13.0.1",
    "tap-spec": "^4.1.2",
    "tape": "^4.9.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslint": "^5.11.0",
    "tslint-config-haiku": "^1.0.16",
    "tsdown": "^0.5.0",
    "typescript": "^5.6.0"
  }
}
