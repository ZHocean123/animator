{
  "name": "@haiku/sdk-client",
  "version": "5.1.2",
  "description": "Haiku SDK for Client",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint src/**/*.{ts,tsx,js,jsx} --fix",
    "lint-report": "pnpm lint -f checkstyle -o checkstyle-result.xml",
    "fix": "pnpm lint --fix",
    "ts": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "pnpm ts ./node_modules/.bin/tape 'test/**/*.test.ts' | tap-spec",
    "test-report": "nyc yarn ts ./node_modules/.bin/tape 'test/**/*.test.ts' > test-result.tap",
    "compile": "tsdown",
    "develop": "tsdown --watch",
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "files": [
    "lib/**/*"
  ],
  "author": "Zack Brown <zack@haiku.ai>",
  "license": "UNLICENSED",
  "dependencies": {
    "@haiku/sdk-inkstone": "workspace:*",
    "dedent": "^0.7.0",
    "dotenv": "^5.0.1",
    "fs-extra": "^4.0.2",
    "lodash": "^4.17.4",
    "mkdirp": "^0.5.1",
    "pascalcase": "0.1.1",
    "request": "^2.83.0"
  },
  "devDependencies": {
    "@types/dedent": "^0.7.0",
    "@types/dotenv": "^4.0.3",
    "@types/fs-extra": "^4.0.8",
    "@types/mkdirp": "^0.3.29",
    "@types/node": "10.12.30",
    "@types/request": "^2.0.0",
    "cross-env": "^5.1.6",
    "haiku-testing": "workspace:*",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "leaked-handles": "^5.2.0",
    "nyc": "^13.0.1",
    "tap-spec": "^4.1.2",
    "tape": "^4.9.0",
    "ts-node": "^6.1.0",
    "tsconfig-paths": "^3.3.2",
    "typescript": "^5.3.0"
  },
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.cts"
}