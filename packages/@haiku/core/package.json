{
  "name": "@haiku/core",
  "version": "5.1.2",
  "description": "Haiku Core is a JavaScript library for building user interfaces",
  "homepage": "https://www.haikuforteams.com",
  "directories": {
    "lib": "lib",
    "dom": "dom",
    "components": "components",
    "dist": "dist"
  },
  "keywords": [
    "animation",
    "motion",
    "component",
    "web",
    "browser",
    "svg",
    "rendering",
    "engine"
  ],
  "repository": "https://github.com/HaikuTeam/core",
  "main": "index.js",
  "scripts": {
    "lint": "eslint --exclude 'src/vendor/**' 'src/**/*.ts'",
    "lint-report": "pnpm lint -f checkstyle -o checkstyle-result.xml",
    "fix": "pnpm lint --fix",
    "ts": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "pnpm ts ./node_modules/.bin/tape 'test/**/*.test.ts' | tap-spec",
    "test-report": "nyc yarn ts ./node_modules/.bin/tape 'test/**/*.test.ts' > test-result.tap",
    "compile": "tsdown",
    "develop": "tsdown --watch",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "bundle": "pnpm compile && yarn ts ./scripts/bundle.ts",
    "demos": "pnpm ts ./scripts/demos.ts"
  },
  "authors": [
    "Matthew Trost <matthew@haiku.ai>",
    "Zack Brown <zack@haiku.ai>",
    "Taylor Poe <taylor@haiku.ai>",
    "Sasha Joseph <sasha@haiku.ai>"
  ],
  "license": "MIT",
  "devDependencies": {
    "@angular/core": "^18.0.0",
    "async": "^3.2.4",
    "chokidar": "^3.5.3",
    "cross-env": "^7.0.3",
    "depcheck": "^1.4.7",
    "express": "^4.18.2",
    "filesize": "^10.0.8",
    "fs-extra": "^11.1.1",
    "haiku-testing": "workspace:*",
    "handlebars": "^4.7.8",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "jsdom": "^22.1.0",
    "leaked-handles": "^5.2.0",
    "nodemon": "^3.0.1",
    "nyc": "^15.1.0",
    "opn": "^6.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "rollup": "^4.9.5",
    "rollup-plugin-commonjs": "^10.1.0",
    "rollup-plugin-json": "^4.0.0",
    "rollup-plugin-node-resolve": "^5.2.0",
    "rollup-plugin-uglify-es": "^0.0.1",
    "rxjs": "^7.8.1",
    "tap-spec": "^5.0.0",
    "tape": "^5.7.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsdown": "^0.15.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "peerDependencies": {
    "@angular/core": "^18.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
