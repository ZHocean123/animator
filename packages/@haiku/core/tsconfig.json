{
  "compileOnSave": true,
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM"
    ],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    // 包特定的路径映射
    "baseUrl": ".",
    "rootDir": "src",
    "paths": {
      "@core/*": [
        "src/*"
      ]
    },
    "typeRoots": [
      "node_modules/@types/"
    ],
    // 覆盖基础配置的特定选项
    "allowJs": false,
    "preserveConstEnums": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "lib",
    "dist"
  ]
}
