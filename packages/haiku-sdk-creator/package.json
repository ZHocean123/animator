{
  "name": "haiku-sdk-creator",
  "version": "5.1.2",
  "description": "SDK into Haiku",
  "main": "lib/index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "lint": "tslint -p tsconfig.all.json -t stylish",
    "lint-report": "pnpm lint -t checkstyle -o checkstyle-result.xml",
    "fix": "pnpm lint --fix",
    "ts": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "pnpm ts ./node_modules/.bin/tape 'test/**/*.test.ts' | tap-spec",
    "test-report": "nyc pnpm ts ./node_modules/.bin/tape 'test/**/*.test.ts' > test-result.tap",
    "compile": "tsc",
    "develop": "tsc --watch"
  },
  "authors": [
    "Zack Brown <zack@haiku.ai>",
    "Matthew Trost <matthew@haiku.ai>"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@haiku/sdk-client": "workspace:*",
    "@haiku/sdk-inkstone": "workspace:*",
    "haiku-common": "workspace:*",
    "haiku-serialization": "workspace:*",
    "qs": "^6.12.0",
    "ws": "3.2.0"
  },
  "devDependencies": {
    "@types/ws": "^3.0.2",
    "cross-env": "^7.0.3",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "nyc": "^13.0.1",
    "tap-spec": "^4.1.2",
    "tape": "^4.9.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslint": "^5.11.0",
    "tslint-config-haiku": "^1.0.16",
    "typescript": "^5.6.0",
    "leaked-handles": "^5.2.0",
    "haiku-testing": "workspace:*"
  }
}