{
  "compileOnSave": true,
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 覆盖基础配置的特定选项
    "allowJs": false,
    "declarationDir": "lib",
    "preserveConstEnums": false,
    "outDir": "lib",
    "rootDir": "src",
    "typeRoots": [
      "node_modules/@types/"
    ],
    // 包特定的路径映射
    "baseUrl": ".",
    "paths": {
      "@sdk-creator/*": ["src/*"],
      "@common/*": ["../haiku-common/src/*"]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "lib",
    "dist"
  ]
}
