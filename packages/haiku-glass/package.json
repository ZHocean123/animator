{
  "name": "haiku-glass",
  "version": "5.1.2",
  "private": true,
  "authors": [
    "Matthew Trost <matthew@haiku.ai>",
    "Zack Brown <zack@haiku.ai>",
    "Taylor Poe <taylor@haiku.ai>"
  ],
  "dependencies": {
    "@haiku/core": "5.1.2",
    "color": "^4.2.3",
    "haiku-common": "5.1.2",
    "haiku-fs-extra": "5.1.2",
    "haiku-serialization": "5.1.2",
    "haiku-ui-common": "5.1.2",
    "haiku-vendor-legacy": "5.1.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "qs": "^6.11.2",
    "radium": "^0.26.2",
    "raven-js": "^3.27.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "async": "^3.2.4",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "haiku-testing": "5.1.2",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "jsdom": "^22.1.0",
    "leaked-handles": "^5.2.0",
    "nyc": "^15.1.0",
    "prop-types": "^15.8.1",
    "tap-spec": "^5.0.0",
    "tape": "^5.7.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsdown": "^0.15.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "typescript": "^5.3.3",
    "@types/node": "^20.0.0"
  },
  "scripts": {
    "lint": "eslint 'src/**/*.{ts,tsx,js,jsx}'",
    "lint-report": "yarn lint -f checkstyle -o checkstyle-result.xml",
    "fix": "yarn lint --fix",
    "ts": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "yarn ts ./node_modules/.bin/tape 'test/**/*.test.ts' 'test/**/*.test.js' | tap-spec",
    "test-report": "nyc yarn ts ./node_modules/.bin/tape 'test/**/*.test.ts' 'test/**/*.test.js' > test-result.tap",
    "compile": "tsdown",
    "compile-declarations": "tsdown -p tsconfig.declarations.json",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "develop": "tsdown --watch",
    "start": "cross-env AUTOSTART=main electron --enable-logging --remote-debugging-port=9222 ./lib/electron.js"
  }
}
