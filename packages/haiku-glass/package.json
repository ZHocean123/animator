{
  "name": "haiku-glass",
  "version": "5.1.2",
  "private": true,
  "authors": [
    "Matthew Trost <matthew@haiku.ai>",
    "Zack Brown <zack@haiku.ai>",
    "Taylor Poe <taylor@haiku.ai>"
  ],
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./electron": {
      "import": "./lib/electron.mjs",
      "require": "./lib/electron.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.cts",
  "scripts": {
    "lint": "eslint src/**/*.{ts,tsx,js,jsx} --fix",
    "lint-report": "pnpm lint -f checkstyle -o checkstyle-result.xml",
    "fix": "pnpm lint --fix",
    "ts": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "pnpm ts ./node_modules/.bin/tape 'test/**/*.test.ts' 'test/**/*.test.js' | tap-spec",
    "test-report": "nyc pnpm ts ./node_modules/.bin/tape 'test/**/*.test.ts' 'test/**/*.test.js' > test-result.tap",
    "compile": "tsdown",
    "compile-declarations": "tsdown -p tsconfig.declarations.json",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "develop": "tsdown --watch",
    "start": "cross-env AUTOSTART=main electron --enable-logging --remote-debugging-port=9222 ./lib/electron.js"
  },
  "dependencies": {
    "@haiku/core": "workspace:*",
    "color": "^4.2.3",
    "haiku-common": "workspace:*",
    "haiku-fs-extra": "workspace:*",
    "haiku-serialization": "workspace:*",
    "haiku-ui-common": "workspace:*",
    "haiku-vendor-legacy": "workspace:*",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "qs": "^6.11.2",
    "radium": "^0.26.2",
    "raven-js": "^3.27.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "async": "^3.2.4",
    "cross-env": "^7.0.3",
    "electron": "catalog:",
    "haiku-testing": "workspace:*",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "jsdom": "^22.1.0",
    "leaked-handles": "^5.2.0",
    "nyc": "^15.1.0",
    "prop-types": "^15.8.1",
    "tap-spec": "^5.0.0",
    "tape": "^5.7.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0"
  }
}
