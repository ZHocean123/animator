{
  "compileOnSave": true,
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react",
    "lib": [
      "ES2017",
      "dom"
    ],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "noImplicitAny": true,
    "outDir": "lib",
    "preserveConstEnums": true,
    "rootDir": "src",
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "ES5",
    "types": [
      "node"
    ],
    "typeRoots": [
      "node_modules/@types/"
    ]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}