{
  "compileOnSave": true,
  "compilerOptions": {
    "target": "esnext",
    "jsx": "react",
    "lib": [
      "ES2017",
      "dom"
    ],
    "rootDir": "src",
    "module": "preserve",
    "moduleResolution": "bundler",
    "typeRoots": [
      "node_modules/@types/"
    ],
    "types": [
      "node"
    ],
    "allowJs": true,
    "noImplicitAny": true,
    "outDir": "lib",
    "preserveConstEnums": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
