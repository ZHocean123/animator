{
  "name": "haiku-timeline",
  "version": "5.1.2",
  "private": true,
  "license": "UNLICENSED",
  "authors": [
    "Matthew Trost <matthew@haiku.ai>",
    "Taylor Poe <taylor@haiku.ai>",
    "Zack Brown <zack@haiku.ai>"
  ],
  "scripts": {
    "lint": "tslint -p tsconfig.all.json -t stylish",
    "lint-report": "pnpm lint -t checkstyle -o checkstyle-result.xml",
    "fix": "pnpm lint --fix",
    "ts": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json ./node_modules/tape/bin/tape 'test/**/*.test.ts' 'test/**/*.test.js' | tap-spec",
    "test-report": "nyc pnpm ts ./node_modules/tape/bin/tape 'test/**/*.test.ts' 'test/**/*.test.js' > test-result.tap",
    "compile": "tsdown",
    "compile-declarations": "tsdown --tsconfig tsconfig.declarations.json",
    "develop": "tsdown --watch",
    "start": "cross-env AUTOSTART=main electron --enable-logging --remote-debugging-port=9222 ./lib/electron.js"
  },
  "dependencies": {
    "@haiku/core": "5.1.2",
    "classnames": "2.2.5",
    "codemirror": "^5.28.0",
    "color": "^2.0.1",
    "haiku-common": "5.1.2",
    "haiku-formats": "5.1.2",
    "haiku-fs-extra": "5.1.2",
    "haiku-serialization": "5.1.2",
    "haiku-ui-common": "5.1.2",
    "qs": "^6.12.0",
    "radium": "0.18.1",
    "raven-js": "3.21.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-draggable": "2.2.3",
    "react-popover": "^0.4.18",
    "strip-indent": "^2.0.0",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^22.3.0",
    "haiku-testing": "5.1.2",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "jsdom": "^11.1.0",
    "leaked-handles": "^5.2.0",
    "nyc": "^13.0.1",
    "tap-spec": "^4.1.2",
    "tape": "^4.9.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslint": "^5.11.0",
    "tslint-config-haiku": "^1.0.16",
    "tsdown": "^0.5.0",
    "typescript": "^5.6.0"
  }
}
