{
  "name": "haiku-creator",
  "productName": "Haiku",
  "type": "module",
  "version": "5.1.2",
  "private": true,
  "description": "Haiku Creator UI",
  "author": "Matthew Trost <matthew@haiku.ai>",
  "license": "PROPRIETARY",
  "main": "./out/main/index.js",
  "module": "./out/index.mjs",
  "types": "./out/index.d.cts",
  "scripts": {
    "lint": "eslint src/**/*.{ts,tsx,js,jsx} --fix",
    "lint-report": "pnpm lint -f checkstyle -o checkstyle-result.xml",
    "fix": "pnpm lint --fix",
    "ts": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "pnpm ts ./node_modules/.bin/tape 'test/**/*.test.ts' 'test/**/*.test.js' | tap-spec",
    "test-report": "nyc pnpm ts ./node_modules/.bin/tape 'test/**/*.test.ts' 'test/**/*.test.js' > test-result.tap",
    "electron-dev": "cross-env DEV=1 electron-vite dev  -- --trace-warnings",
    "electron-build": "electron-vite build",
    "electron-preview": "electron-vite preview",
    "start": "electron ./out/main/index.js",
    "start1": "electron-vite build && cross-env NODE_ENV=production HAIKU_PLUMBING_PORT=9221 DEV=1 electron --trace-deprecation ./out/main/index.js"
  },
  "dependencies": {
    "@babel/parser": "7.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@haiku/core": "workspace:*",
    "@haiku/taylor-nocon": "^0.0.2",
    "@haiku/tina-haikuerror": "^0.0.6",
    "@sentry/react": "^7.108.0",
    "async": "^3.2.4",
    "better-react-spinkit": "2.0.0-4",
    "color": "^4.2.3",
    "electron-updater": "^6.6.2",
    "event-emitter": "^0.3.5",
    "fast-safe-stringify": "^2.1.1",
    "fs-extra": "^11.1.1",
    "haiku-common": "workspace:*",
    "haiku-glass": "workspace:*",
    "haiku-sdk-creator": "workspace:*",
    "haiku-serialization": "workspace:*",
    "haiku-timeline": "workspace:*",
    "haiku-ui-common": "workspace:*",
    "lodash": "^4.17.21",
    "lodash.assign": "^4.2.0",
    "lodash.debounce": "4.0.8",
    "marked": "^12.0.0",
    "mixpanel": "^0.13.0",
    "monaco-editor": "^0.45.0",
    "node-fetch": "^3.3.2",
    "open": "^10.1.0",
    "prettier": "^3.6.2",
    "qs": "^6.12.0",
    "radium": "^0.26.2",
    "react": "catalog:",
    "react-animations": "^1.0.0",
    "react-click-away-listener": "^2.2.2",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "catalog:",
    "react-drag-and-drop": "^3.0.0",
    "react-draggable": "^4.4.6",
    "react-list": "^0.8.17",
    "react-onclickoutside": "^6.13.2",
    "react-popover": "^0.5.10",
    "react-select": "^5.8.0",
    "react-selectize": "^3.0.1",
    "react-transition-group": "^4.4.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.5",
    "@types/node": "^22.19.1",
    "@types/qs": "^6.9.12",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^7.0.3",
    "electron": "catalog:",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "haiku-testing": "workspace:*",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "leaked-handles": "^5.2.0",
    "nyc": "^15.1.0",
    "tap-spec": "^5.0.0",
    "tape": "^5.7.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "catalog:",
    "vite": "^5.4.8"
  }
}
