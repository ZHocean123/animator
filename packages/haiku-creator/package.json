{
  "name": "haiku-creator",
  "productName": "Haiku",
  "private": true,
  "version": "5.1.2",
  "description": "Haiku Creator UI",
  "main": "out/main/index.js",
  "author": "Matthew Trost <matthew@haiku.ai>",
  "license": "PROPRIETARY",
  "scripts": {
    "lint": "tslint -p tsconfig.all.json -t stylish",
    "lint-report": "pnpm run lint -t checkstyle -o checkstyle-result.xml",
    "fix": "pnpm run lint --fix",
    "ts": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "cross-env TS_NODE_PROJECT=tsconfig.all.json NODE_ENV=test NODE_OPTIONS=\"-r ts-node/register -r tsconfig-paths/register\" ./node_modules/.bin/tape \"test/**/*.test.ts\" \"test/**/*.test.js\" | tap-spec",
    "test-report": "nyc cross-env TS_NODE_PROJECT=tsconfig.all.json NODE_ENV=test NODE_OPTIONS=\"-r ts-node/register -r tsconfig-paths/register\" ./node_modules/.bin/tape \"test/**/*.test.ts\" \"test/**/*.test.js\" > test-result.tap",
    "compile": "tsc",
    "compile-declarations": "tsc -p tsconfig.declarations.json",
    "develop": "tsc --watch",
    "dev": "powershell -NoProfile -Command \"pnpm run build; Start-Job { Start-Sleep -Seconds 5; $env:ELECTRON_RENDERER_URL='http://localhost:5173/'; $env:HAIKU_PLUMBING_PORT='9999'; $env:HAIKU_WS_SECURITY_TOKEN='dev'; pnpm exec electron . } | Out-Null; pnpm exec vite\"",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "pnpm dev"
  },
  "dependencies": {
    "@babel/parser": "7.0.0",
    "@haiku/core": "workspace:*",
    "@haiku/taylor-nocon": "^0.0.2",
    "@haiku/tina-haikuerror": "^0.0.6",
    "async": "^2.5.0",
    "better-react-spinkit": "2.0.0-4",
    "color": "^2.0.1",
    "electron-proxy-agent": "^1.0.2",
    "electron-updater": "^6.0.0",
    "event-emitter": "^0.3.5",
    "fast-safe-stringify": "^2.0.4",
    "fs-extra": "^4.0.2",
    "haiku-common": "workspace:*",
    "haiku-glass": "workspace:*",
    "haiku-sdk-creator": "workspace:*",
    "haiku-serialization": "workspace:*",
    "haiku-timeline": "workspace:*",
    "haiku-ui-common": "workspace:*",
    "lodash": "^4.17.4",
    "lodash.assign": "^4.2.0",
    "lodash.debounce": "4.0.8",
    "marked": "^0.3.17",
    "mixpanel": "0.6.0",
    "monaco-editor": "^0.15.6",
    "node-fetch": "^2.0.0-alpha.9",
    "opn": "^5.3.0",
    "qs": "6.4.0",
    "radium": "0.18.1",
    "raven-js": "3.21.0",
    "react": "15.6.2",
    "react-animations": "0.1.0",
    "react-dom": "15.6.2",
    "react-drag-and-drop": "2.4.0",
    "react-draggable": "2.2.3",
    "react-list": "^0.8.9",
    "react-onclickoutside": "^6.4.0",
    "react-popover": "^0.4.18",
    "react-selectize": "^3.0.1",
    "react-transition-group": "^2.2.1",
    "uuid": "^3.2.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^4.0.8",
    "@types/node": "10.12.30",
    "@types/react": "15.6.11",
    "@types/react-dom": "15.5.6",
    "@types/node-fetch": "^2.1.1",
    "@types/qs": "^6.5.1",
    "@types/uuid": "^3.2.1",
    "cross-env": "^5.1.6",
    "electron": "^30.0.0",
    "electron-vite": "^2.0.0",
    "haiku-testing": "workspace:*",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "leaked-handles": "^5.2.0",
    "nyc": "^13.0.1",
    "tap-spec": "^4.1.2",
    "tape": "^4.9.0",
    "ts-node": "^6.1.0",
    "tsconfig-paths": "^3.3.2",
    "tslint": "^5.11.0",
    "tslint-config-haiku": "^1.0.16",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "@haiku/core": "^5.0.0"
  }
}