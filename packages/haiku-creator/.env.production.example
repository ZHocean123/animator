# Electron-Vite Production Environment Variables
# Copy this file to .env.production and update values as needed

# Node Environment
NODE_ENV=production

# Haiku API Endpoints
HAIKU_API=https://inkstone.haiku.ai/
HAIKU_WWW=https://www.haiku.ai/
HAIKU_ACCOUNT=https://account.haiku.ai/
HAIKU_SHARE=https://share.haiku.ai/

# Production Configuration
DEV=0
HAIKU_PLUMBING_PORT=9221

# Electron Configuration
ELECTRON_IS_DEV=false
ELECTRON_ENABLE_LOGGING=false
ELECTRON_REMOTE_DEBUGGING_PORT=

# Monaco Editor Configuration
VITE_MONACO_EDITOR_BASE_URL=/node_modules/monaco-editor/

# Build Configuration
VITE_BUILD_TARGET=production
VITE_SOURCEMAP=false

# Application Metadata
VITE_APP_NAME=Haiku
VITE_APP_VERSION=5.1.2
VITE_APP_DESCRIPTION=Haiku Animator

# Analytics and Error Reporting
VITE_MIXPANEL_TOKEN=
VITE_SENTRY_DSN=

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_DEBUG_MODE=false