# Electron-Vite Environment Variables
# Copy this file to .env and update the values as needed

# Node Environment
NODE_ENV=development

# Haiku API Endpoints
HAIKU_API=http://localhost:8080/
HAIKU_WWW=http://localhost:8000/
HAIKU_ACCOUNT=http://localhost:3001/
HAIKU_SHARE=http://localhost:3000/

# Development Configuration
DEV=1
HAIKU_PLUMBING_PORT=9221

# Electron Configuration
ELECTRON_IS_DEV=true
ELECTRON_ENABLE_LOGGING=true
ELECTRON_REMOTE_DEBUGGING_PORT=9222

# Monaco Editor Configuration
VITE_MONACO_EDITOR_BASE_URL=/node_modules/monaco-editor/

# Build Configuration
VITE_BUILD_TARGET=production
VITE_SOURCEMAP=false

# Application Metadata
VITE_APP_NAME=Haiku
VITE_APP_VERSION=5.1.2
VITE_APP_DESCRIPTION=Haiku Animator

# Analytics and Error Reporting
VITE_MIXPANEL_TOKEN=
VITE_SENTRY_DSN=

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_DEBUG_MODE=false