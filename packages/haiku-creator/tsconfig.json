{
  "compileOnSave": true,
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react",
    "lib": [
      "ES2017",
      "dom"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "outDir": "lib",
    "preserveConstEnums": true,
    "rootDir": "src",
    "sourceMap": true,
    "target": "esnext"
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}