{
  "name": "haiku-serialization",
  "type": "module",
  "version": "5.1.2",
  "description": "Serialization utilities",
  "author": "Matthew Trost <matthew@haiku.ai>",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "require": "./lib/index.cjs",
      "import": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.cts",
  "files": [
    "lib"
  ],
  "scripts": {
    "test": "pnpm test:all",
    "test:all": "cross-env NODE_ENV=test tape \"test/**/**/*.test.js\" | tap-spec || true",
    "test:utils": "cross-env NODE_ENV=test tape \"test/utils/**/*.test.js\" | tap-spec || true",
    "test:bll": "cross-env NODE_ENV=test tape \"test/bll/**/*.test.js\" | tap-spec || true",
    "test-report": "cross-env NODE_ENV=test tape \"test/**/**/*.test.js\" > test-result.tap",
    "lint": "eslint src/**/* --fix",
    "lint-report": "pnpm lint -f checkstyle -o checkstyle-result.xml",
    "fix": "eslint src/**/*.{ts,tsx,js,jsx} --fix",
    "compile": "tsdown",
    "develop": "tsdown --watch",
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@babel/core": "^7.24.9",
    "@babel/generator": "^7.24.9",
    "@babel/parser": "^7.24.8",
    "@babel/traverse": "^7.24.8",
    "@haiku/core": "workspace:*",
    "@haiku/sdk-client": "workspace:*",
    "@haiku/sdk-inkstone": "workspace:*",
    "async": "^3.2.4",
    "axios": "^1.7.2",
    "camelcase": "^8.0.0",
    "colors": "^1.4.0",
    "crypto-js": "^4.2.0",
    "cst": "^0.4.10",
    "decamelize": "^6.0.0",
    "dedent": "^1.0.0",
    "estree-walker": "^3.0.3",
    "fast-fuzzy": "^1.12.0",
    "fs-extra": "^11.1.1",
    "fuzzy-string-matching": "^1.0.2",
    "gl-matrix": "^3.4.3",
    "haiku-common": "workspace:*",
    "haiku-formats": "workspace:*",
    "haiku-fs-extra": "workspace:*",
    "haiku-sdk-creator": "workspace:*",
    "haiku-ui-common": "workspace:*",
    "haiku-vendor-legacy": "workspace:*",
    "image-size": "^1.1.1",
    "json-stable-stringify-without-jsonify": "^1.0.1",
    "lodash": "^4.17.21",
    "lodash.assign": "^4.2.0",
    "lodash.clonedeepwith": "^4.5.0",
    "lodash.debounce": "4.0.8",
    "lodash.defaults": "^4.2.0",
    "lodash.find": "^4.6.0",
    "lodash.merge": "4.6.0",
    "mixpanel": "^0.13.0",
    "node-hook": "^0.4.1",
    "numeral": "^2.0.6",
    "pascalcase": "^1.0.0",
    "pngjs": "^7.0.0",
    "point-in-polygon": "^1.1.0",
    "polygon-overlap": "^1.0.5",
    "prettier": "^3.3.2",
    "pretty": "^2.0.0",
    "raf": "^3.4.1",
    "snake-case": "^3.0.4",
    "standard": "^17.1.0",
    "svgo": "^3.3.2",
    "titlecase": "^1.1.3",
    "unique-selector": "^0.5.0",
    "uuid": "^9.0.1",
    "winston": "^3.13.1"
  },
  "devDependencies": {
    "@types/async": "^3.2.24",
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/crypto-js": "^4.2.2",
    "@types/fs-extra": "^11.0.4",
    "@types/gl-matrix": "^3.2.0",
    "@types/lodash": "^4.17.5",
    "@types/node": "^22.19.1",
    "@types/prettier": "^3.0.0",
    "@types/uuid": "^9.0.8",
    "@types/winston": "^2.4.4",
    "cross-env": "^7.0.3",
    "haiku-testing": "workspace:*",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "leaked-handles": "^5.2.0",
    "nyc": "^15.1.0",
    "semver": "^7.6.0",
    "snazzy": "^9.0.0",
    "standard": "^17.1.0",
    "tap-spec": "^5.0.0",
    "tape": "^5.7.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "catalog:"
  }
}
