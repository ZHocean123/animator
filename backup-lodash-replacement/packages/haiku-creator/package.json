{
  "name": "haiku-creator",
  "productName": "Haiku",
  "private": true,
  "version": "5.1.2",
  "description": "Haiku Creator UI",
  "main": "index.js",
  "author": "Matthew Trost <matthew@haiku.ai>",
  "license": "PROPRIETARY",
  "scripts": {
    "lint": "tslint -p tsconfig.all.json -t stylish",
    "lint-report": "pnpm lint -t checkstyle -o checkstyle-result.xml",
    "fix": "pnpm lint --fix",
    "ts": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json ./node_modules/tape/bin/tape 'test/**/*.test.ts' 'test/**/*.test.js' | tap-spec",
    "test-report": "nyc pnpm ts ./node_modules/tape/bin/tape 'test/**/*.test.ts' 'test/**/*.test.js' > test-result.tap",
    "compile": "tsdown",
    "compile-declarations": "tsdown --tsconfig tsconfig.declarations.json",
    "develop": "tsdown --watch",
    "start": "electron ./lib/electron.js"
  },
  "dependencies": {
    "@babel/parser": "7.0.0",
    "@electron/remote": "^2.1.3",
    "@haiku/core": "workspace:*",
    "@haiku/taylor-nocon": "^0.0.2",
    "@haiku/tina-haikuerror": "^0.0.6",
    "async": "^2.5.0",
    "better-react-spinkit": "2.0.0-4",
    "color": "^2.0.1",
    "electron-proxy-agent": "^1.0.2",
    "electron-updater": "^6.1.7",
    "event-emitter": "^0.3.5",
    "fast-safe-stringify": "^2.0.4",
    "fs-extra": "^11.2.0",
    "haiku-common": "workspace:*",
    "haiku-glass": "workspace:*",
    "haiku-sdk-creator": "workspace:*",
    "haiku-serialization": "workspace:*",
    "haiku-timeline": "workspace:*",
    "haiku-ui-common": "workspace:*",
    "marked": "^9.1.6",
    "mixpanel": "0.6.0",
    "monaco-editor": "^0.15.6",
    "node-fetch": "^2.0.0-alpha.9",
    "opn": "^5.3.0",
    "qs": "^6.12.0",
    "radium": "0.18.1",
    "raven-js": "3.21.0",
    "react": "^18.3.0",
    "react-animations": "0.1.0",
    "react-dom": "^18.3.0",
    "react-drag-and-drop": "2.4.0",
    "react-draggable": "2.2.3",
    "react-list": "^0.8.9",
    "react-onclickoutside": "^6.4.0",
    "react-popover": "^0.4.18",
    "react-selectize": "^3.0.1",
    "react-transition-group": "^2.2.1",
    "uuid": "^3.2.1",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.0",
    "@types/node-fetch": "^2.1.1",
    "@types/qs": "^6.9.0",
    "@types/uuid": "^3.2.1",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "haiku-testing": "workspace:*",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "leaked-handles": "^5.2.0",
    "nyc": "^13.0.1",
    "tap-spec": "^4.1.2",
    "tape": "^4.9.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslint": "^5.11.0",
    "tslint-config-haiku": "^1.0.16",
    "tsdown": "^0.5.0",
    "typescript": "^5.6.0"
  }
}
