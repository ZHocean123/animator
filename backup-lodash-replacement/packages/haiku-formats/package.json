{
  "name": "haiku-formats",
  "version": "5.1.2",
  "description": "Formatting-related utilities for Haiku.",
  "main": "lib/index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "lint": "tslint -p tsconfig.all.json --exclude '../**' -t stylish",
    "lint-report": "pnpm lint -t checkstyle -o checkstyle-result.xml",
    "fix": "pnpm lint --fix",
    "ts": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -P tsconfig.all.json ./node_modules/tape/bin/tape 'test/**/*.test.ts' | tap-spec",
    "test-report": "nyc pnpm ts ./node_modules/tape/bin/tape 'test/**/*.test.ts' > test-result.tap",
    "compile": "tsdown",
    "develop": "tsdown --watch",
    "regenerate-goldens": "pnpm ts ./scripts/regenerate-goldens.ts",
    "upgrade-goldens": "pnpm ts ./scripts/upgrade-goldens.ts",
    "demos": "node ./scripts/demos.js"
  },
  "authors": [
    "Sasha Joseph <sasha@haiku.ai>"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@haiku/core": "workspace:*",
    "bezier-easing": "^2.0.3",
    "ffmpeg-static": "^2.3.0",
    "fluent-ffmpeg": "^2.1.2",
    "fs-extra": "^11.2.0",
    "haiku-common": "workspace:*",
    "haiku-sdk-creator": "workspace:*",
    "haiku-serialization": "workspace:*",
    "image-size": "^0.6.3",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@types/async": "^2.0.49",
    "@types/bezier-easing": "^2.0.0",
    "@types/ffmpeg-static": "^2.0.0",
    "@types/fluent-ffmpeg": "^2.1.6",
    "@types/fs-extra": "^11.0.0",
    "@types/image-size": "^0.0.29",
    "@types/lodash": "^4.17.0",
    "async": "^2.5.0",
    "cross-env": "^7.0.3",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "nyc": "^13.0.1",
    "tap-spec": "^4.1.2",
    "tape": "^4.9.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslint": "^5.11.0",
    "tslint-config-haiku": "^1.0.16",
    "tsdown": "^0.5.0",
    "typescript": "^5.6.0",
    "leaked-handles": "^5.2.0",
    "haiku-testing": "workspace:*",
    "lottie-web": "5.1.20",
    "nodemon": "1.11.0",
    "ts-loader": "^9.5.0",
    "walk-sync": "^0.3.2",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-concat-plugin": "^3.0.0",
    "@types/lodash-es": "^4.17.12"
  }
}
